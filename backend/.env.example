# Copy to .env before running `cargo run`.

# SQLite file; created automatically on first boot.
DATABASE_URL=sqlite://furniture.db

# Bind address for the API server.
HOST=127.0.0.1
PORT=8080

# HS256 signing key. Replace with a long random string outside of local dev.
JWT_SECRET=dev-only-change-me-to-something-long-and-random

# Token lifetime in hours.
JWT_TTL_HOURS=24

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RUST_LOG=info,furniture_buyer_api=debug

# --- Furniture shop API -----------------------------------------------------
# Source of truth for the catalogue, balance, and orders.
# Real credentials belong in .env (gitignored), never here.
EXTERNAL_API_BASE_URL=https://day1.training.cognitivo.com.au

# Participant id and key issued by the organisers. Every local login shares
# this one upstream account — there is only one key.
EXTERNAL_API_USER_ID=
EXTERNAL_API_KEY=

# Auth is a single header. Configurable in case the scheme changes.
EXTERNAL_API_KEY_HEADER=X-Api-Key

EXTERNAL_API_TIMEOUT_SECS=15
