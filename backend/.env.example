# Copy to .env before running `cargo run`.

# SQLite file; created automatically on first boot.
DATABASE_URL=sqlite://furniture.db

# Bind address for the API server.
HOST=127.0.0.1
PORT=8080

# HS256 signing key. Replace with a long random string outside of local dev.
JWT_SECRET=dev-only-change-me-to-something-long-and-random

# Token lifetime in hours.
JWT_TTL_HOURS=24

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Budget granted to newly registered buyers, in cents.
DEFAULT_BUDGET_CENTS=500000

RUST_LOG=info,furniture_buyer_api=debug

# --- Upstream hackathon API -------------------------------------------------
# Real values belong in .env (gitignored), never here.
#
# Base URL of the lab API. UNCONFIRMED — the participant guide is behind GitHub
# SSO, so this has not been verified against the real service.
EXTERNAL_API_BASE_URL=

# Participant credentials issued by the organisers.
EXTERNAL_API_USER_ID=
EXTERNAL_API_KEY=

# Auth scheme is also unconfirmed, so the header names are configurable: if the
# API wants `Authorization: Bearer <key>`, set EXTERNAL_API_KEY_HEADER to
# Authorization and prefix the key value accordingly — no code change needed.
EXTERNAL_API_KEY_HEADER=X-API-Key
EXTERNAL_API_USER_HEADER=X-User-Id

EXTERNAL_API_TIMEOUT_SECS=10
